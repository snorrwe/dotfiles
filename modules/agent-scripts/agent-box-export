#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo 'Usage: agent-box-export -b /absolute/path/to/binary [--name host-command]' >&2
    exit 2
}

[[ $# -ge 2 && ("$1" == -b || "$1" == --bin) ]] || usage
binary=$2
name=${binary##*/}
shift 2
while (($#)); do
    case "$1" in
    --name)
        (($# >= 2)) || usage
        name=$2
        shift 2
        ;;
    *) usage ;;
    esac
done

if [[ "$binary" != /* || ! -f "$binary" || ! -x "$binary" ]]; then
    echo "Expected an executable at an absolute container path: $binary" >&2
    exit 1
fi
if [[ ! "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]]; then
    echo "Invalid host command name: $name" >&2
    exit 1
fi

host_bin=/run/agent-host-bin
if [[ ! -d "$host_bin" || ! -w "$host_bin" ]]; then
    echo "Host bin mount is unavailable: $host_bin" >&2
    exit 1
fi
target=$host_bin/$name
if [[ -e "$target" || -L "$target" ]]; then
    echo "Host command already exists (will not overwrite): $target" >&2
    exit 1
fi

# Write in the same directory, then link without replacing an existing file.
# Keep the container path (not its Nix-store symlink target) across image updates.
umask 077
tmp=$(mktemp -- "$host_bin/.agent-box-export.XXXXXXXX")
trap 'rm -f -- "$tmp"' EXIT
printf -v quoted_binary '%q' "$binary"
printf '#!/usr/bin/env bash\n# Generated by agent-box-export\nexec agent-box -- %s "$@"\n' "$quoted_binary" >"$tmp"
chmod 0755 "$tmp"
ln -T -- "$tmp" "$target"
printf 'Exported %s to host ~/.local/bin/%s\n' "$binary" "$name"
