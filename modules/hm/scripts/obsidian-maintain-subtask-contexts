#!/usr/bin/env nu

let obsidian = "md.obsidian.Obsidian"

def frontmatter [] {
    split list "---" | get "content" | flatten | get 0 | from yaml
}

# FIXME: there's got to be a better way
def optional_list [] {
  do {
    if ($in | is-empty) {
      []
    } else {
      $in
    }
  }
}

def read_contexts [file] {
  let file_contexts = open $file | frontmatter | get -o contexts | optional_list | sort
  try {
    if ($file_contexts | any {|| ($in | str starts-with "Error:") or ($in == "(empty)") }) {
      return []
    }
  } catch {
    return []
  }
  return $file_contexts
}

def is_task [file]: any -> bool {
  try {
    open $file | frontmatter | get tags | any {|| $in == "task" or $in == "project"}
  } catch {|err|
    print -e $"is_task: failed to get tags for ($file): ($err)"
    return false
  }
}

# Update file contexts based on its parents' contexts
# Not recursive, only considers immediate parents
# If notes_dir is omitted $HOME/notes is used
def main [file notes_dir?:string] {
  let pwd = if ($notes_dir | is-empty) { 
    $env.HOME | path join "notes"
  } else {
    $notes_dir 
  };
  cd $pwd
  let f = $file | path relative-to $pwd
  run_file $f 0

  null
}

def run_file [file depth: int] {
  if not (is_task $file) {
    print $"($file) is not a task"
    return
  }
  if $depth > 10 {
    # stop recursion. it should stop naturally even if the notes link each-other
    # but let's make sure in case there are multiple parallel updates that trigger each-other
    print "max depth reached"
    return
  }

  print $"Syncing file contexts ($file)"
  let projects = open $file | frontmatter | get -o projects | optional_list | parse --regex '\[\[(?P<link>[-\w./\s]+)(\|.*)?\]\]'
  print $"Projects: ($projects)"
  let file_contexts = read_contexts $file
  let contexts = $projects.link | each {|p|
    # the markdown links omit the file extension
    read_contexts $"($p).md"
  } | flatten | append $file_contexts | sort | uniq

  # if parents have no contexts, then keep the file's contexts
  # do not overwrite if they're same, because it might trigger file watchers unnecesserily
  if $file_contexts != $contexts {
    print $"Updating context of file ($file) to ($contexts)"
    run-external $obsidian property:set name=contexts $"path=($file)" $"value=($contexts | to json)" type=list
  }

  # recursively update children
  try {
    run-external $obsidian backlinks $"path=($file)" format=json | from json
     | each {|l|
      try {
        run_file $l.file ($depth + 1)
      }
    };
  } catch {|err|
    print -e $"Error getting backlinks for ($file): ($err)"
  }
  null
}
